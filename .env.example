# Copy this file to .env.local and fill in the two values from the Supabase
# project (dashboard → Connect, or Project Settings → API). It's the same project
# and the same two values as the staff site.
# Leave them empty to run in test mode (made-up schedule, saved in this browser).
#
# Only the Project URL and the anon / publishable key go here.
# NEVER put the service_role / secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
